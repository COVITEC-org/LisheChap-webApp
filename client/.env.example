# LisheChap client environment
# Copy to client/.env when you need to override defaults.
# Only variables prefixed with VITE_ are exposed to the browser, so NEVER put secrets here.

# Base path or URL of the API. Leave as /api to use the Vite dev proxy (development)
# or the same-origin server (production).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api requests during development.
VITE_DEV_API_PROXY=http://localhost:4000
