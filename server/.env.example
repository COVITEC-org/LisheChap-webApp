# LisheChap server environment
# Copy this file to server/.env and fill in real values.
# Never commit server/.env. Real secrets belong only in your deployment platform.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Interface to bind. Use 0.0.0.0 inside containers.
HOST=0.0.0.0

# Public URL of the React client. Used for CORS and links in emails/notifications.
# Several origins can be given as a comma-separated list.
CLIENT_URL=http://localhost:5173

# Public URL of this API server. Used for payment callbacks and absolute links.
SERVER_URL=http://localhost:4000

# Number of reverse proxies in front of the server (0 when none).
# Needed so rate limiting and audit logs see the real client IP.
TRUST_PROXY=0

# Log verbosity: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# When true (production), the API also serves the built React client from client/dist.
SERVE_CLIENT_BUILD=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://lishechap:lishechap@localhost:5432/lishechap?schema=public

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Secret for signing access tokens (Phase 3). Minimum 32 characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Secret for signing session/refresh cookies (Phase 3). Minimum 32 characters in production.
SESSION_SECRET=

# General API rate limit: max requests per window per client IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------------------------------------------------------------------------
# Optional infrastructure
# ---------------------------------------------------------------------------

# Redis connection (optional). Planned for presence, timers, socket scaling,
# rate limiting and notification queues. Leave empty for single-instance development.
REDIS_URL=

# ---------------------------------------------------------------------------
# Integrations (wired in later phases)
# ---------------------------------------------------------------------------

# Google Maps Platform server key (Phase 9). Leave empty to use the safe external fallback.
GOOGLE_MAPS_API_KEY=

# Payment provider credentials (Phase 8). Real keys are supplied per provider when
# the official APIs are available. Until then only development/mock providers run.
# Format: JSON object keyed by provider code, for example
# {"MPESA":{"apiKey":"...","publicKey":"..."},"AIRTEL_MONEY":{...}}
PAYMENT_PROVIDER_KEYS=

# Web Push VAPID keys (Phase 9). Generate with the web-push library.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=
