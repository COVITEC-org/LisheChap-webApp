// LisheChap database schema.
// Phase 1 establishes the datasource, client generator and conventions.
// Domain models (users, restaurants, menu, availability, orders, payments,
// wallets) are added in their respective phases, see PROJECT_PLAN.md.
//
// Conventions:
//   - Model names are PascalCase, tables are snake_case via @@map.
//   - Primary keys are UUIDs generated by the database.
//   - Every table has createdAt/updatedAt timestamps.
//   - Money is stored as integer Tanzanian Shillings (Int), never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Platform-wide configurable values (for example the availability response
// window or heartbeat timeout). Edited by administrators in later phases.
model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
